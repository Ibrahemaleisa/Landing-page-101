---
/** Kitebase wordmark: a kite glyph and the name. The Latin wordmark is used in both locales. */
export interface Props {
  class?: string;
}
const { class: cls } = Astro.props;
---

<span class:list={["kb-logo", cls]} dir="ltr">
  <svg viewBox="0 0 32 32" width="28" height="28" aria-hidden="true">
    <rect width="32" height="32" fill="currentColor"></rect>
    <path d="M9 23 16 7l7 16-7-4z" fill="var(--tone-highlight)"></path>
  </svg>
  <span class="kb-logo__word">kitebase</span>
</span>

<style>
  @layer site {
    .kb-logo {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
    }
    .kb-logo__word {
      font-family: var(--font-space-grotesk), sans-serif;
      font-weight: 700;
      font-size: 1.375rem;
      letter-spacing: -0.04em;
      line-height: 1;
    }
  }
</style>
