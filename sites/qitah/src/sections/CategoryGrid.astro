---
/**
 * Category tiles: a compact, scannable grid of link tiles (icon, name, typical parts). Built from kit
 * primitives because the kit's Features grid is a capability list (filled accent icon, body copy),
 * not a navigation grid. Icons follow the brand rule: Lucide-style line icons at 1.75 stroke.
 */
import Section from "@landing/kit/primitives/Section.astro";
import SectionHeader from "@landing/kit/primitives/SectionHeader.astro";
import Icon from "@landing/kit/primitives/Icon.astro";
import type { CategoryIcon, Content } from "../content/types";

export interface Props {
  id: string;
  tone?: string;
  c: Content["categories"];
}

const { id, tone, c } = Astro.props;
const headingId = `${id}-title`;

/** 24×24 stroke paths (Lucide, ISC licence, plus two simple drawings for suspension and body). */
const ICONS: Record<CategoryIcon, string> = {
  brakes: '<circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="3"/><path d="M12 3v2"/><path d="M12 19v2"/><path d="M3 12h2"/><path d="M19 12h2"/>',
  filters: '<path d="M3 4h18l-7 8.5V19l-4 2v-8.5z"/>',
  oils: '<path d="M12 22a7 7 0 0 0 7-7c0-2-1-3.9-3-5.5s-3.5-4-4-6.5c-.5 2.5-2 4.9-4 6.5C6 11.1 5 13 5 15a7 7 0 0 0 7 7z"/>',
  engine:
    '<path d="M12 20a8 8 0 1 0 0-16 8 8 0 0 0 0 16Z"/><path d="M12 14a2 2 0 1 0 0-4 2 2 0 0 0 0 4Z"/><path d="M12 2v2"/><path d="M12 22v-2"/><path d="m17 20.66-1-1.73"/><path d="M11 10.27 7 3.34"/><path d="m20.66 17-1.73-1"/><path d="m3.34 7 1.73 1"/><path d="M14 12h8"/><path d="M2 12h2"/><path d="m20.66 7-1.73 1"/><path d="m3.34 17 1.73-1"/><path d="m17 3.34-1 1.73"/><path d="m11 13.73-4 6.93"/>',
  suspension: '<path d="M12 2v3"/><path d="M12 19v3"/><path d="M7 5h10"/><path d="M7 19h10"/><path d="m8 8 8 2-8 2 8 2-8 2"/>',
  electrical: '<rect width="16" height="10" x="2" y="7" rx="2"/><path d="M22 11v2"/><path d="m11 9-2 3h4l-2 3"/>',
  lighting:
    '<path d="M15 14c.2-1 .7-1.7 1.5-2.5 1-.9 1.5-2.2 1.5-3.5A6 6 0 0 0 6 8c0 1 .2 2.2 1.5 3.5.7.7 1.3 1.5 1.5 2.5"/><path d="M9 18h6"/><path d="M10 22h4"/>',
  cooling: '<path d="M14 4v10.54a4 4 0 1 1-4 0V4a2 2 0 0 1 4 0Z"/>',
  body: '<path d="M19 17h2c.6 0 1-.4 1-1v-3c0-.9-.7-1.7-1.5-1.9C18.7 10.6 16 10 16 10s-1.3-1.4-2.2-2.3c-.5-.4-1.1-.7-1.8-.7H5c-.6 0-1.1.4-1.4.9l-1.4 2.9A3.7 3.7 0 0 0 2 12v4c0 .6.4 1 1 1h2"/><circle cx="7" cy="17" r="2"/><path d="M9 17h6"/><circle cx="17" cy="17" r="2"/>',
};
---

<Section id={id} tone={tone} labelledby={headingId} class="q-cats">
  <SectionHeader id={headingId} title={c.title} eyebrow={c.eyebrow} lead={c.lead} layout="split" />
  <ul role="list" class="q-cats__grid">
    {c.items.map((it) => (
      <li class="lk-reveal">
        <a class="q-cat" href={`?category=${it.id}#results`}>
          <span class="q-cat__icon">
            <Icon paths={ICONS[it.id]} size="1.625rem" />
          </span>
          <span class="q-cat__text">
            <span class="q-cat__name">{it.name}</span>
            <span class="q-cat__hint">{it.hint}</span>
          </span>
          <Icon name="chevron-right" class="q-cat__go" />
        </a>
      </li>
    ))}
  </ul>
</Section>

<style>
  @layer site {
    .q-cats__grid {
      display: grid;
      gap: var(--space-xs);
      grid-template-columns: repeat(auto-fill, minmax(min(17rem, 100%), 1fr));
    }
    /* phones: two compact columns, icon above the name */
    @media (max-width: 39.99rem) {
      .q-cats__grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }
      .q-cat {
        flex-direction: column;
        align-items: start;
        gap: var(--space-xs);
      }
      .q-cat__icon {
        inline-size: 2.75rem;
        block-size: 2.75rem;
      }
      .q-cat :global(.q-cat__go) {
        display: none;
      }
    }
    @media (min-width: 64rem) {
      .q-cats__grid {
        grid-template-columns: repeat(3, 1fr);
      }
    }
    .q-cat {
      display: flex;
      align-items: center;
      gap: var(--space-s);
      block-size: 100%;
      padding: var(--space-s);
      border-radius: var(--radius-card);
      background: var(--tone-surface);
      color: var(--tone-surface-fg);
      border: 1px solid var(--tone-surface-line);
      text-decoration: none;
      transition:
        border-color var(--motion-base) var(--motion-ease),
        box-shadow var(--motion-base) var(--motion-ease),
        transform var(--motion-base) var(--motion-ease);
    }
    .q-cat:hover {
      border-color: #cbd3e1;
      box-shadow: var(--shadow-card);
      transform: translateY(-2px);
    }
    .q-cat__icon {
      display: grid;
      place-items: center;
      flex: none;
      inline-size: 3.25rem;
      block-size: 3.25rem;
      border-radius: var(--radius-control);
      background: #e8eef8;
      color: #022b74;
    }
    .q-cat__text {
      display: grid;
      gap: 0.1rem;
      flex: 1;
      min-inline-size: 0;
    }
    .q-cat__name {
      font-weight: 700;
      font-size: var(--step-1);
      color: var(--tone-heading);
      line-height: 1.3;
    }
    .q-cat__hint {
      font-size: var(--step--1);
      color: var(--tone-surface-fg-muted);
    }
    .q-cat :global(.q-cat__go) {
      color: var(--tone-surface-fg-muted);
      transition: translate var(--motion-fast) var(--motion-ease);
    }
    @media (hover: hover) {
      .q-cat:hover :global(.q-cat__go) {
        translate: 0.15em 0;
      }
      :global(:dir(rtl)) .q-cat:hover :global(.q-cat__go) {
        translate: -0.15em 0;
      }
    }
  }
</style>
