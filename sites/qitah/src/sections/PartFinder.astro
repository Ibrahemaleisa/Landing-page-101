---
/**
 * Qitah signature: the vehicle-first part finder. A real GET form (make → model → year, then a part
 * name or OEM number) built on native, labelled controls, so it works without JavaScript, with the
 * keyboard and with screen readers. Models are grouped by make with `<optgroup>`, which keeps the
 * choice dependent on the make without a script.
 */
import Button from "@landing/kit/components/Button.astro";
import Icon from "@landing/kit/primitives/Icon.astro";
import BrandSymbol from "../components/BrandSymbol.astro";
import type { Content } from "../content/types";

export interface Props {
  c: Content["finder"];
  /** Legend for the vehicle group, e.g. "Your car". */
  vehicleLegend: string;
}

const { c, vehicleLegend } = Astro.props;
const q = (term: string) => `?q=${encodeURIComponent(term)}#results`;
---

<div class="q-finder" id="finder">
  <div class="q-finder__head">
    <span class="q-finder__icon">
      <Icon name="car" size="1.5rem" />
    </span>
    <div>
      <h2 id="finder-title" class="q-finder__title">
        {c.title}
      </h2>
      <p class="q-finder__lead">{c.lead}</p>
    </div>
  </div>

  <form class="q-finder__form" method="get" action="#results" aria-labelledby="finder-title">
    <fieldset class="q-finder__vehicle">
      <legend class="lk-visually-hidden">{vehicleLegend}</legend>
      <div class="q-field">
        <label for="q-make">{c.make.label}</label>
        <select id="q-make" name="make" class="q-control" autocomplete="off">
          <option value="">{c.make.placeholder}</option>
          {c.make.options.map((o) => (
            <option value={o.value}>{o.label}</option>
          ))}
        </select>
      </div>
      <div class="q-field">
        <label for="q-model">{c.model.label}</label>
        <select id="q-model" name="model" class="q-control" autocomplete="off">
          <option value="">{c.model.placeholder}</option>
          {c.model.groups.map((g) => (
            <optgroup label={g.label}>
              {g.options.map((o) => (
                <option value={o.value}>{o.label}</option>
              ))}
            </optgroup>
          ))}
        </select>
      </div>
      <div class="q-field">
        <label for="q-year">{c.year.label}</label>
        <select id="q-year" name="year" class="q-control" autocomplete="off">
          <option value="">{c.year.placeholder}</option>
          {c.year.options.map((o) => (
            <option value={o.value}>{o.label}</option>
          ))}
        </select>
      </div>
    </fieldset>

    <div class="q-field">
      <label for="q-query">{c.query.label}</label>
      <div class="q-search">
        <Icon name="search" size="1.25rem" class="q-search__icon" />
        <input
          id="q-query"
          name="q"
          type="search"
          class="q-control q-search__input"
          placeholder={c.query.placeholder}
          aria-describedby="q-query-hint"
          autocomplete="off"
          enterkeyhint="search"
        />
      </div>
      <p id="q-query-hint" class="q-field__hint">
        {c.query.hint}
      </p>
    </div>

    <Button type="submit" size="lg" block icon="search" iconStart class="q-finder__submit">
      {c.submit}
    </Button>
  </form>

  <div class="q-finder__popular">
    <p id="finder-popular" class="q-finder__popular-label">
      {c.popularLabel}
    </p>
    <ul role="list" aria-labelledby="finder-popular">
      {c.popular.map((term) => (
        <li>
          <a href={q(term)}>{term}</a>
        </li>
      ))}
    </ul>
  </div>

  <p class="q-finder__fit">
    <BrandSymbol width="2.75rem" />
    <span>
      <strong>{c.fit.label}</strong> <span class="q-finder__fit-detail">{c.fit.detail}</span>
    </span>
  </p>
</div>

<style>
  @layer site {
    .q-finder {
      display: grid;
      gap: var(--space-s);
      padding: clamp(1.25rem, 1rem + 1.5vw, 2rem);
      border-radius: calc(var(--radius-card) + 4px);
      background: var(--tone-surface);
      color: var(--tone-surface-fg);
      border: 1px solid var(--tone-surface-line);
      box-shadow:
        0 1px 2px rgb(10 22 51 / 0.04),
        0 24px 48px -24px rgb(2 43 116 / 0.28);
      text-align: start;
    }
    .q-finder__head {
      display: flex;
      gap: var(--space-xs);
      align-items: start;
    }
    .q-finder__icon {
      display: grid;
      place-items: center;
      flex: none;
      inline-size: 2.75rem;
      block-size: 2.75rem;
      border-radius: var(--radius-control);
      background: #e8eef8;
      color: #022b74;
    }
    .q-finder__title {
      font-size: var(--step-2);
      color: var(--tone-heading);
    }
    .q-finder__lead {
      color: var(--tone-surface-fg-muted);
      font-size: var(--step--1);
    }
    .q-finder__form {
      display: grid;
      gap: var(--space-s);
    }
    .q-finder__vehicle {
      display: grid;
      gap: var(--space-xs);
      grid-template-columns: repeat(auto-fit, minmax(min(9.5rem, 100%), 1fr));
      min-inline-size: 0;
      padding: 0;
      border: 0;
    }
    .q-field {
      display: grid;
      gap: 0.35rem;
      min-inline-size: 0;
    }
    .q-field label {
      font-size: var(--step--1);
      font-weight: 600;
    }
    .q-field__hint {
      font-size: var(--step--1);
      color: var(--tone-surface-fg-muted);
    }
    .q-control {
      inline-size: 100%;
      min-block-size: var(--control-height);
      padding-block: 0.5em;
      padding-inline: 0.85em;
      border: 1px solid #8a94a8;
      border-radius: var(--radius-control);
      background-color: #ffffff;
      color: var(--tone-surface-fg);
      font-size: var(--step-0);
      transition:
        border-color var(--motion-fast) var(--motion-ease),
        box-shadow var(--motion-fast) var(--motion-ease);
    }
    .q-control:hover {
      border-color: #566179;
    }
    .q-control:focus-visible {
      outline: 2px solid var(--tone-ring);
      outline-offset: 1px;
      border-color: var(--tone-ring);
    }
    .q-control::placeholder {
      color: var(--tone-surface-fg-muted);
      opacity: 1;
    }
    .q-search {
      position: relative;
    }
    .q-search :global(.q-search__icon) {
      position: absolute;
      inset-block-start: 50%;
      inset-inline-start: 0.85rem;
      translate: 0 -50%;
      color: var(--tone-surface-fg-muted);
      pointer-events: none;
    }
    .q-search__input {
      padding-inline-start: 2.75rem;
    }
    .q-finder :global(.q-finder__submit) {
      margin-block-start: var(--space-3xs);
    }
    .q-finder__popular {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: var(--space-2xs) var(--space-xs);
      padding-block-start: var(--space-s);
      border-block-start: 1px solid var(--tone-surface-line);
    }
    .q-finder__popular-label {
      font-size: var(--step--1);
      color: var(--tone-surface-fg-muted);
    }
    .q-finder__popular ul {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-3xs);
    }
    .q-finder__popular a {
      display: inline-flex;
      align-items: center;
      min-block-size: 2.25rem;
      padding-inline: 0.85em;
      border-radius: 999px;
      background: #f5f7fa;
      border: 1px solid #e3e8f0;
      color: #022b74;
      font-size: var(--step--1);
      font-weight: 600;
      text-decoration: none;
      transition:
        background-color var(--motion-fast) var(--motion-ease),
        border-color var(--motion-fast) var(--motion-ease);
    }
    .q-finder__popular a:hover {
      background: #e8eef8;
      border-color: #cbd3e1;
    }
    .q-finder__fit {
      display: flex;
      align-items: center;
      gap: var(--space-xs);
      padding: 0.75rem 1rem;
      border-radius: var(--radius-control);
      background: #e8eef8;
      color: #0a1633;
      font-size: var(--step--1);
    }
    .q-finder__fit strong {
      color: #022b74;
      font-weight: 700;
    }
    .q-finder__fit-detail {
      color: #566179;
    }
  }
</style>
