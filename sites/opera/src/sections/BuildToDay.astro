---
/**
 * The claim, shown: one hall during the build, bleeding off the start edge, and the same hall on
 * the day laid over its far corner. Composed from kit primitives (Media, tokens) in Opera's
 * editorial manner; it lives in the site because the composition is Opera's.
 */
import type { ImageMetadata } from "astro";
import Media from "@landing/kit/primitives/Media.astro";

export interface Props {
  title: string;
  body: string;
  before: { src: ImageMetadata; alt: string; caption: string };
  after: { src: ImageMetadata; alt: string; caption: string };
}

const { title, body, before, after } = Astro.props;
---

<div class="op-build">
  <div class="op-build__copy lk-container">
    <h3 class="lk-eyebrow lk-reveal">{title}</h3>
    <p class="lk-text-muted lk-reveal">{body}</p>
  </div>
  <figure class="op-build__before lk-reveal">
    <Media src={before.src} alt={before.alt} fill sizes="(min-width: 64rem) 62vw, 100vw" focus="50% 40%" />
    <figcaption class="op-tag">
      <span class="lk-tabular">01</span>
      {before.caption}
    </figcaption>
  </figure>
  <figure class="op-build__after lk-reveal">
    <div class="op-build__frame">
      <Media src={after.src} alt={after.alt} fill sizes="(min-width: 64rem) 40vw, 80vw" />
      <figcaption class="op-tag">
        <span class="lk-tabular">02</span>
        {after.caption}
      </figcaption>
    </div>
  </figure>
</div>

<style>
  @layer site {
    .op-build {
      position: relative;
      margin-block: var(--section-gap);
    }
    .op-build__copy {
      display: grid;
      gap: var(--space-xs);
    }
    .op-build__copy p {
      max-inline-size: 26rem;
    }
    .op-build__before {
      position: relative;
      margin-block-start: var(--space-m);
      aspect-ratio: 4 / 5;
      overflow: hidden;
    }
    .op-build__after {
      position: relative;
      z-index: 1;
      inline-size: 80%;
      margin-block-start: -5rem;
      margin-inline-start: auto;
      padding-inline-end: var(--gutter);
    }
    .op-build__frame {
      position: relative;
      aspect-ratio: 4 / 3;
      overflow: hidden;
      outline: 10px solid var(--tone-bg);
    }
    .op-tag {
      position: absolute;
      inset-block-start: var(--space-s);
      inset-inline-start: var(--space-s);
      z-index: 1;
      display: inline-flex;
      gap: 0.5em;
      padding: 0.35em 0.85em;
      border-radius: 999px;
      background: rgb(8 5 14 / 0.78);
      color: #f5f2f8;
      font-size: var(--step--1);
    }
    .op-tag span {
      color: #c9b3e6;
    }
    @media (min-width: 40rem) {
      .op-build__before {
        aspect-ratio: 16 / 11;
      }
      .op-build__after {
        inline-size: 58%;
        margin-block-start: -7rem;
      }
    }
    @media (min-width: 64rem) {
      .op-build {
        min-block-size: min(82vh, 780px);
        margin-block-end: calc(var(--section-gap) + 4rem);
      }
      .op-build__copy {
        position: absolute;
        inset-block-start: 0;
        inset-inline-end: 0;
        inline-size: 36%;
        max-inline-size: none;
        margin: 0;
        padding-inline: var(--space-l) max(var(--gutter), calc((100vw - var(--container)) / 2));
      }
      .op-build__before {
        inline-size: 62%;
        block-size: min(82vh, 780px);
        aspect-ratio: auto;
        margin-block-start: 0;
      }
      .op-build__after {
        position: absolute;
        inset-inline-end: 0;
        inset-block-end: -4rem;
        inline-size: 44%;
        margin: 0;
        padding-inline-end: max(var(--gutter), calc((100vw - var(--container)) / 2));
      }
    }
  }
</style>
