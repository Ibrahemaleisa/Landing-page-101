---
/**
 * A tiny picture of one studio option, drawn with the option's real values so the choice cards show
 * what they do instead of describing it. Decorative: the card's text label carries the meaning.
 */
import { BUTTONS, DENSITIES, ELEVATIONS, HEROES, MOTIONS, PAGES, SCALES, SHAPES, TYPOGRAPHY, type ElementKey } from "../studio/options";
import { PALETTES } from "../studio/palettes";
import { cssVar } from "../studio/fonts";

interface Props {
  element: ElementKey;
  id: string;
  locale: "ar" | "en";
}
const { element, id, locale } = Astro.props;
const find = <T extends { id: string }>(list: readonly T[]) => list.find((o) => o.id === id)!;
const ar = locale === "ar";

const swatches = (pid: string) => {
  const t = PALETTES.find((p) => p.id === pid)!.tones;
  return [t.base.bg, t.base.accent, t.inverse.bg, t.brand.bg];
};

let style: Record<string, string> = {};
let parts: Record<string, string>[] = [];
switch (element) {
  case "palette":
    parts = swatches(id).map((c) => ({ background: c }));
    break;
  case "type": {
    const t = find(TYPOGRAPHY).value;
    parts = [
      { "font-family": `var(${cssVar(t.latin.display)}), ${t.generic ?? "sans-serif"}`, "font-weight": String(t.display.weight) },
      { "font-family": `var(${cssVar(t.arabic.display)}), sans-serif`, "font-weight": String(Math.min(t.display.weight, 700)) },
    ];
    break;
  }
  case "scale": {
    const s = find(SCALES).value;
    style = { "--size": `${(0.9 + (s.maxRatio ** s.displayStep - 3) * 0.25).toFixed(2)}rem` };
    break;
  }
  case "buttons": {
    const b = find(BUTTONS).value;
    const family = { mono: "var(--font-jetbrains), monospace", display: "var(--font-display)", body: "inherit" }[b.control.family ?? "body"];
    style = {
      "border-radius": `${Math.min(b.radius, 999) * 0.75}px`,
      "min-block-size": `${Math.round(b.control.height * 0.62)}px`,
      "font-weight": String(b.control.weight),
      "text-transform": b.control.transform ?? "none",
      // Arabic is joined script: tracking would break the letters apart (the kit zeroes it too)
      "letter-spacing": ar ? "0" : (b.control.tracking ?? "0"),
      "font-family": family,
    };
    break;
  }
  case "shape": {
    const s = find(SHAPES).value;
    style = { "border-radius": `${s.card * 0.6}px`, "border-width": `${s.border}px`, "--media": `${s.media * 0.45}px` };
    break;
  }
  case "elevation": {
    const e = find(ELEVATIONS).value;
    const shadow =
      e === "tinted"
        ? "0 6px 14px -5px color-mix(in srgb, var(--tone-accent) 70%, transparent)"
        : e.style === "soft"
          ? "0 6px 14px -5px rgb(0 0 0 / 0.35)"
          : e.style === "hard"
            ? `${e.offset ?? 4}px ${e.offset ?? 4}px 0 var(--tone-fg)`
            : "none";
    style = { "box-shadow": shadow, ...(e !== "tinted" && e.style === "hard" ? { "border-color": "var(--tone-fg)" } : {}) };
    break;
  }
  case "density": {
    const d = find(DENSITIES).value;
    style = { gap: { compact: "2px", comfortable: "5px", airy: "9px" }[d] };
    break;
  }
  case "motion": {
    const m = find(MOTIONS).value;
    style = { "--dur": `${Math.max(m.duration.slow * 1.6, 1)}ms`, "--ease": m.ease };
    break;
  }
}
const pageBlocks = element === "page" ? find(PAGES).value : [];
const hero = element === "hero" ? find(HEROES).value : undefined;
const still = element === "motion" && find(MOTIONS).value.reveal === "none";
---

<span class="art" data-art={element} aria-hidden="true">
  {element === "palette" && parts.map((p) => <span class="art__sw" style={p} />)}
  {element === "type" && (
    <>
      <span class="art__glyph" style={parts[0]}>
        Aa
      </span>
      <span class="art__glyph" style={parts[1]}>
        أب
      </span>
    </>
  )}
  {element === "scale" && (
    <>
      <span class="art__big" style={style}>
        {ar ? "أ" : "A"}
      </span>
      <span class="art__lines">
        <span />
        <span />
      </span>
    </>
  )}
  {element === "buttons" && (
    <span class="art__btn" style={style}>
      {ar ? "ابدأ" : "Start"}
    </span>
  )}
  {element === "shape" && (
    <span class="art__card" style={style}>
      <span class="art__media" />
    </span>
  )}
  {element === "elevation" && <span class="art__lift" style={style} />}
  {element === "density" && (
    <span class="art__stack" style={style}>
      <span />
      <span />
      <span />
    </span>
  )}
  {element === "motion" && (
    <span class="art__track" style={style} data-still={still || undefined}>
      <span class="art__dot" />
    </span>
  )}
  {hero && (
    <span class="art__hero" data-hero={hero}>
      <span class="art__h1" />
      <span class="art__h2" />
      <span class="art__fig" />
    </span>
  )}
  {element === "page" && (
    <span class="art__page">
      {pageBlocks.map(([, , tone]) => (
        <span data-t={tone} />
      ))}
    </span>
  )}
  {/* component styles */}
  {(element === "btnFill" || element === "btnHover") && (
    <span class="art__btn2" data-fill={element === "btnFill" ? id : "solid"} data-hover={element === "btnHover" ? id : undefined}>
      {ar ? "ابدأ" : "Start"} <span aria-hidden="true">{ar ? "←" : "→"}</span>
    </span>
  )}
  {element === "headAlign" && (
    <span class="art__head" data-align={id}>
      <span class="a-eb" />
      <span class="a-t" />
      <span class="a-l" />
    </span>
  )}
  {element === "eyebrow" && (
    <span class="art__head" data-eb={id}>
      <span class="art__eb">{ar ? "المزايا" : "FEATURES"}</span>
      <span class="a-t" />
    </span>
  )}
  {element === "titleMark" && (
    <span class="art__title" data-mark={id}>
      {ar ? "عنوان" : "Title"}
    </span>
  )}
  {element === "divider" && (
    <span class="art__div" data-div={id}>
      <span />
    </span>
  )}
  {element === "pattern" && <span class="art__pat" data-pat={id} />}
  {element === "patternScope" && (
    <span class="art__mini" data-scope={id}>
      <span class="m-top" />
      <span class="m-rest" />
    </span>
  )}
  {element === "image" && (
    <span class="art__img" data-img={id}>
      <span />
    </span>
  )}
  {element === "icon" && (
    <span class="art__ico" data-ico={id}>
      <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M13 2 3 14h9l-1 8 10-12h-9l1-8z" />
      </svg>
    </span>
  )}
  {element === "input" && (
    <span class="art__input" data-in={id}>
      <span>{ar ? "الاسم" : "Name"}</span>
    </span>
  )}
  {/* site parts */}
  {element === "splash" && (
    <span class="art__screen" data-splash={id}>
      <span class="s-logo" />
      {id === "line" && <span class="s-line" />}
    </span>
  )}
  {element === "announce" && (
    <span class="art__mini" data-announce={id}>
      <span class="m-strip">{id === "marquee" && <span class="m-dash" />}</span>
      <span class="m-header" />
      <span class="m-rest" />
    </span>
  )}
  {element === "headerLayout" && (
    <span class="art__hdr" data-hl={id}>
      <span class="h-logo" />
      <span class="h-nav">
        <span />
        <span />
        <span />
      </span>
      <span class="h-btn" />
      <span class="h-menu" />
    </span>
  )}
  {element === "headerLook" && (
    <span class="art__mini" data-look={id}>
      <span class="m-header" data-tone={id === "dark" ? "inverse" : undefined} />
      <span class="m-rest" />
    </span>
  )}
  {element === "headerBehavior" && (
    <span class="art__mini" data-behavior={id}>
      <span class="m-header" />
      <span class="m-rest" />
      <span class="m-scroll" />
    </span>
  )}
  {element === "navStyle" && (
    <span class="art__nav" data-nav={id}>
      <span>{ar ? "من" : "About"}</span>
      <span class="is-on">{ar ? "خدمات" : "Work"}</span>
    </span>
  )}
  {element === "footerLayout" && (
    <span class="art__ftr" data-fl={id}>
      <span class="f-big" />
      <span class="f-logo" />
      <span class="f-cols">
        <span />
        <span />
        <span />
      </span>
      <span class="f-base" />
    </span>
  )}
  {element === "footerTone" && <span class="art__tone" data-tone={id} />}
  {element === "whatsapp" && (
    <span class="art__mini" data-wa={id}>
      <span class="m-header" />
      <span class="m-rest" />
      {id !== "none" && <span class="m-wa" />}
    </span>
  )}
</span>
