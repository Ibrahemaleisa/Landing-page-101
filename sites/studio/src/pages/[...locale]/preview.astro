---
/**
 * The live preview. Every section variant is rendered once; a small script applies the selection:
 * it swaps the brand CSS, then shows, orders and re-tones the blocks the chosen templates use. It
 * reads the selection from the query string (open it on its own) or from the studio via postMessage.
 */
import BaseLayout from "@landing/kit/layouts/BaseLayout.astro";
import SiteHeader from "@landing/kit/components/SiteHeader.astro";
import Hero from "@landing/kit/sections/Hero.astro";
import Statement from "@landing/kit/sections/Statement.astro";
import LogoCloud from "@landing/kit/sections/LogoCloud.astro";
import Showcase from "@landing/kit/sections/Showcase.astro";
import Features from "@landing/kit/sections/Features.astro";
import FeatureNarrative from "@landing/kit/sections/FeatureNarrative.astro";
import Steps from "@landing/kit/sections/Steps.astro";
import Stats from "@landing/kit/sections/Stats.astro";
import Testimonials from "@landing/kit/sections/Testimonials.astro";
import Comparison from "@landing/kit/sections/Comparison.astro";
import Pricing from "@landing/kit/sections/Pricing.astro";
import FAQ from "@landing/kit/sections/FAQ.astro";
import CTA from "@landing/kit/sections/CTA.astro";
import Contact from "@landing/kit/sections/Contact.astro";
import Footer from "@landing/kit/sections/Footer.astro";
import Form from "@landing/kit/components/Form.astro";
import Field from "@landing/kit/components/Field.astro";
import Button from "@landing/kit/components/Button.astro";
import { localeHref, localePaths } from "@landing/kit/i18n";
import { site, type Locale } from "../../site";
import { previewContent } from "../../content/preview";
import { DEFAULT_SELECTION, PAGES, buildBrand } from "../../studio/options";
import { FONT_FAMILIES, cssVar } from "../../studio/fonts";
import Art from "../../components/Art.astro";
import ProductCard from "../../components/ProductCard.astro";
import AppWindow from "../../components/AppWindow.astro";
import Logo from "../../components/Logo.astro";

export const getStaticPaths = () => localePaths(site);

const { locale } = Astro.props as { locale: Locale };
const t = previewContent[locale];
const name = locale === "ar" ? "رواق" : "Rawaq";
const home = localeHref(site, locale, "/preview/");

// server-render the default selection's order so the page is right before the script runs
const initial = new Set(["top:" + DEFAULT_SELECTION.hero, ...PAGES.find((p) => p.id === DEFAULT_SELECTION.page)!.value.map(([b, v]) => `${b}:${v}`)]);
const show = (block: string, variant: string) => !initial.has(`${block}:${variant}`);
const f = t.contact.form;
---

<BaseLayout
  site={site}
  brand={buildBrand(DEFAULT_SELECTION)}
  locale={locale}
  path="/preview/"
  title={t.meta.title}
  description={t.meta.description}
  siteName={name}
  skipLabel={t.ui.skip}
  noindex
  fonts={FONT_FAMILIES.map((ff) => ({ cssVariable: cssVar(ff.id) }))}
>
  <SiteHeader
    site={site}
    locale={locale}
    path="/preview/"
    homeHref={home}
    homeLabel={t.ui.home}
    links={t.nav}
    cta={t.cta}
    labels={{ nav: t.ui.nav, menu: t.ui.menu, close: t.ui.close, language: t.ui.language }}
  >
    <Logo slot="logo" name={name} />
  </SiteHeader>

  <main id="main" data-studio-main>
    <!-- hero: one per composition -->
    <div data-block="top" data-variant="display" hidden={show("top", "display")}>
      <Hero variant="display" id="top-display" eyebrow={t.hero.eyebrow} title={t.hero.title} accentLine={1} lead={t.hero.lead} actions={t.hero.actions}>
        <Art slot="media" variant="orbits" />
        <Fragment slot="meta">
          <span>{t.hero.country}</span>
          <span>{t.hero.note}</span>
        </Fragment>
      </Hero>
    </div>
    <div data-block="top" data-variant="split" hidden={show("top", "split")}>
      <Hero
        variant="split"
        id="top-split"
        eyebrow={t.hero.eyebrow}
        title={t.hero.title}
        accentLine={1}
        lead={t.hero.lead}
        actions={t.hero.actions}
        balance="copy"
      >
        <p slot="after" class="studio-note">
          {t.hero.note}
        </p>
        <ProductCard slot="figure" c={t.card} />
      </Hero>
    </div>
    <div data-block="top" data-variant="centered" hidden={show("top", "centered")}>
      <Hero variant="centered" id="top-centered" eyebrow={t.hero.eyebrow} title={t.hero.title} accentLine={1} lead={t.hero.lead} actions={t.hero.actions}>
        <p slot="after" class="studio-note">
          {t.hero.note}
        </p>
        <AppWindow slot="figure" c={t.app} />
      </Hero>
    </div>
    <div data-block="top" data-variant="statement" hidden={show("top", "statement")}>
      <Hero variant="statement" id="top-statement" eyebrow={t.hero.eyebrow} title={t.hero.title} accentLine={1} lead={t.hero.lead} actions={t.hero.actions} />
    </div>

    <div data-block="statement" data-variant="start" hidden={show("statement", "start")}>
      <Statement id="statement-start" eyebrow={t.statement.eyebrow} index="01" statement={t.statement.text} lead={t.statement.lead} />
    </div>

    <div data-block="logos" data-variant="grid" hidden={show("logos", "grid")}>
      <LogoCloud id="logos-grid" title={t.logos.title} logos={t.logos.names.map((n) => ({ name: n }))} variant="grid" note={t.logos.note} />
    </div>
    <div data-block="logos" data-variant="row" hidden={show("logos", "row")}>
      <LogoCloud id="logos-row" title={t.logos.title} logos={t.logos.names.map((n) => ({ name: n }))} variant="row" note={t.logos.note} />
    </div>

    <div data-block="showcase" data-variant="tabs" hidden={show("showcase", "tabs")}>
      <Showcase
        id="showcase-tabs"
        eyebrow={t.showcase.eyebrow}
        title={t.showcase.title}
        lead={t.showcase.lead}
        tabsLabel={t.showcase.tabsLabel}
        items={t.showcase.items}
        headerLayout="split"
      >
        <Art slot="media-plan" variant="blocks" />
        <Art slot="media-track" variant="waves" />
        <Art slot="media-share" variant="stack" />
      </Showcase>
    </div>

    {(["grid", "list", "index", "bento"] as const).map((v) => (
      <div data-block="features" data-variant={v} hidden={show("features", v)}>
        <Features
          id={`features-${v}`}
          variant={v}
          eyebrow={t.features.eyebrow}
          index={v === "index" ? "02" : undefined}
          title={t.features.title}
          lead={t.features.lead}
          items={v === "bento" ? t.features.items.slice(0, 5) : t.features.items}
          headerLayout={v === "index" ? "split" : "stack"}
        />
      </div>
    ))}

    <div data-block="narrative" data-variant="rows" hidden={show("narrative", "rows")}>
      <FeatureNarrative id="narrative-rows" eyebrow={t.narrative.eyebrow} title={t.narrative.title} items={t.narrative.items}>
        <Art slot="media-0" variant="blocks" />
        <Art slot="media-1" variant="waves" />
        <Art slot="media-2" variant="stack" />
      </FeatureNarrative>
    </div>

    <div data-block="steps" data-variant="cards" hidden={show("steps", "cards")}>
      <Steps id="steps-cards" variant="cards" eyebrow={t.steps.eyebrow} title={t.steps.title} items={t.steps.items.slice(0, 3)} />
    </div>
    <div data-block="steps" data-variant="timeline" hidden={show("steps", "timeline")}>
      <Steps
        id="steps-timeline"
        variant="timeline"
        eyebrow={t.steps.eyebrow}
        title={t.steps.title}
        items={t.steps.items}
        current={2}
        currentLabel={t.steps.now}
      />
    </div>

    {(["row", "cards"] as const).map((v) => (
      <div data-block="stats" data-variant={v} hidden={show("stats", v)}>
        <Stats id={`stats-${v}`} variant={v} eyebrow={t.stats.eyebrow} title={t.stats.title} items={t.stats.items} note={t.stats.note} />
      </div>
    ))}

    {(["grid", "featured"] as const).map((v) => (
      <div data-block="quotes" data-variant={v} hidden={show("quotes", v)}>
        <Testimonials
          id={`quotes-${v}`}
          variant={v}
          eyebrow={t.quotes.eyebrow}
          title={t.quotes.title}
          items={t.quotes.items}
          note={t.quotes.note}
          separator={locale === "ar" ? "، " : ", "}
        />
      </div>
    ))}

    <div data-block="compare" data-variant="table" hidden={show("compare", "table")}>
      <Comparison
        id="compare-table"
        eyebrow={t.compare.eyebrow}
        title={t.compare.title}
        caption={t.compare.caption}
        rowHeader={t.compare.rowHeader}
        columns={t.compare.columns}
        rows={t.compare.rows}
        highlight={0}
        labels={{ yes: t.ui.yes, no: t.ui.no }}
      />
    </div>

    <div data-block="pricing" data-variant="plans" hidden={show("pricing", "plans")}>
      <Pricing
        id="pricing-plans"
        eyebrow={t.pricing.eyebrow}
        title={t.pricing.title}
        lead={t.pricing.lead}
        plans={t.pricing.plans}
        billing={t.pricing.billing}
        footnote={t.pricing.footnote}
      />
    </div>

    {(["split", "stacked"] as const).map((v) => (
      <div data-block="faq" data-variant={v} hidden={show("faq", v)}>
        <FAQ id={`faq-${v}`} variant={v} eyebrow={t.faq.eyebrow} title={t.faq.title} lead={t.faq.lead} items={t.faq.items} />
      </div>
    ))}

    <div data-block="contact" data-variant="form" hidden={show("contact", "form")}>
      <Contact id="contact-form" eyebrow={t.contact.eyebrow} title={t.contact.title} lead={t.contact.lead}>
        <Form action="#contact" label={f.label} successMessage={f.success} errorSummary={f.errors} demo>
          <p class="studio-note">{f.note}</p>
          <Field idPrefix="pf" name="name" label={f.name} required requiredLabel={f.required} autocomplete="name" requiredMessage={f.requiredMsg} />
          <Field
            idPrefix="pf"
            name="email"
            type="email"
            label={f.email}
            required
            requiredLabel={f.required}
            autocomplete="email"
            dir="ltr"
            requiredMessage={f.requiredMsg}
            invalidMessage={f.emailMsg}
          />
          <Field idPrefix="pf" name="message" type="textarea" label={f.message} required requiredLabel={f.required} requiredMessage={f.requiredMsg} />
          <Button type="submit" icon="arrow-right">
            {f.submit}
          </Button>
        </Form>
      </Contact>
    </div>

    {(["band", "split", "panel"] as const).map((v) => (
      <div data-block="close" data-variant={v} data-tone-target={v === "panel" ? ".lk-cta__box" : undefined} hidden={show("close", v)}>
        <CTA id={`close-${v}`} variant={v} title={t.close.title} lead={t.close.lead} actions={t.close.actions} size={v === "band" ? "display" : "h2"} />
      </div>
    ))}
  </main>

  <Footer
    site={site}
    locale={locale}
    path="/preview/"
    tagline={t.footer.tagline}
    groups={t.footer.groups}
    legal={t.footer.legal}
    labels={{ nav: t.ui.footerNav, language: t.ui.language }}
  >
    <Logo slot="logo" name={name} />
  </Footer>
</BaseLayout>

<script>
  import { compileBrand } from "@landing/kit/brand";
  import { PAGES, buildBrand, type Block, type Selection, type Tweaks } from "../../studio/options";
  import { decodeState, encodeSelection } from "../../studio/state";
  import { PLACEHOLDER_NAME, nameFor, type Lang } from "../../studio/project";
  import { getProject, mediaUrls } from "../../studio/store";
  import type { SnapItem, Snapshot } from "../../studio/brief";

  /** What the studio sends. Everything but the style is optional, so a bare URL still previews. */
  interface Apply {
    selection: Selection;
    tweaks?: Tweaks;
    sections?: Block[] | null;
    content?: Record<string, string>;
    name?: string;
    media?: Record<string, string>;
    editing?: boolean;
  }

  const lang: Lang = document.documentElement.lang.startsWith("ar") ? "ar" : "en";
  const main = document.querySelector<HTMLElement>("[data-studio-main]")!;
  const tokens = Array.from(document.querySelectorAll("style")).find((s) => s.textContent?.startsWith("@layer tokens"))!;
  const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('a[href^="#"]'));
  links.forEach((a) => (a.dataset.href = a.getAttribute("href")!));
  const embedded = window.parent !== window;
  const post = (msg: object) => embedded && window.parent.postMessage(msg, location.origin);

  // ---------------------------------------------------------------- editable texts and image slots
  const norm = (s: string | null) => (s ?? "").replace(/\s+/g, " ").trim();
  const SKIP = "svg, script, style, template, input, textarea, select, option, .lk-visually-hidden, .lk-tabs__fallback-title";
  const scopes = [document.querySelector("header"), main, document.querySelector("footer")].filter(Boolean) as HTMLElement[];
  const leaves = scopes.flatMap((root) =>
    Array.from(root.querySelectorAll<HTMLElement>("*")).filter((el) => el.children.length === 0 && norm(el.textContent) && !el.closest(SKIP)),
  );
  leaves.forEach((el) => (el.dataset.k = norm(el.textContent)));

  main.querySelectorAll<HTMLElement>("[data-block]").forEach((w) => {
    const top = Array.from(w.querySelectorAll<HTMLElement>(".art, .pcard, .app")).filter((m) => !m.parentElement?.closest(".art, .pcard, .app"));
    top.forEach((m, n) => (m.dataset.slot = `${w.dataset.block}/${n}`));
  });
  document.querySelectorAll<HTMLElement>(".rlogo").forEach((l) => (l.dataset.slot = "logo"));

  // the placeholder name also hides in text that can't be edited (screen-reader text, labels, alt)
  const ph = PLACEHOLDER_NAME[lang];
  const nameTexts: [Text, string][] = [];
  for (const root of scopes) {
    const walk = document.createTreeWalker(root, NodeFilter.SHOW_TEXT);
    for (let n = walk.nextNode() as Text | null; n; n = walk.nextNode() as Text | null)
      if (n.data.includes(ph) && !n.parentElement?.closest("[data-k], svg, script, style")) nameTexts.push([n, n.data]);
  }
  const nameAttrs: [Element, string, string][] = [];
  document.querySelectorAll("[aria-label], [alt], [title]").forEach((el) =>
    ["aria-label", "alt", "title"].forEach((attr) => {
      const v = el.getAttribute(attr);
      if (v?.includes(ph)) nameAttrs.push([el, attr, v]);
    }),
  );

  let state: Apply = { selection: decodeState(location.search).selection };
  let active: HTMLElement | null = null;

  const base = (k: string) => (state.name ? k.split(ph).join(state.name) : k);
  const textFor = (k: string) => state.content?.[k] ?? base(k);

  function applyTexts() {
    const swap = (v: string) => (state.name ? v.split(ph).join(state.name) : v);
    for (const [node, orig] of nameTexts) node.data = swap(orig);
    for (const [el, attr, orig] of nameAttrs) el.setAttribute(attr, swap(orig));
    for (const el of leaves) {
      if (el === active) continue;
      const v = textFor(el.dataset.k!);
      if (norm(el.textContent) !== v) el.textContent = v;
    }
  }

  function applyMedia() {
    document.querySelectorAll<HTMLElement>("[data-slot]").forEach((el) => {
      const url = state.media?.[el.dataset.slot!];
      let img = el.querySelector<HTMLImageElement>(":scope > img.studio-img");
      if (url) {
        if (!img) {
          img = document.createElement("img");
          img.className = "studio-img";
          img.alt = "";
          el.append(img);
        }
        if (img.src !== url) img.src = url;
        el.dataset.filled = "";
      } else {
        img?.remove();
        delete el.dataset.filled;
      }
    });
  }

  function apply(next: Apply) {
    state = next;
    tokens.textContent = compileBrand(buildBrand(next.selection, "Studio", next.tweaks ?? {}), { locales: ["ar", "en"] });

    const blocks = Array.from(main.querySelectorAll<HTMLElement>("[data-block]"));
    blocks.forEach((b) => {
      b.hidden = true;
      b.removeAttribute("id");
    });
    const page = next.sections ?? (PAGES.find((p) => p.id === next.selection.page) ?? PAGES[0]!).value;
    const order: Block[] = [["top", next.selection.hero, "base"], ...page];
    const used = new Set<string>();
    for (const [block, variant, tone] of order) {
      const w = main.querySelector<HTMLElement>(`[data-block="${block}"][data-variant="${variant}"]`);
      if (!w || !w.hidden) continue;
      w.hidden = false;
      w.id = used.has(block) ? `${block}-${variant}` : block;
      used.add(block);
      w.querySelector(w.dataset.toneTarget ?? "section")?.setAttribute("data-tone", tone);
      main.appendChild(w);
    }

    // in-page links whose target this page doesn't have: hide nav items, retarget buttons
    for (const a of links) {
      const id = a.dataset.href!.slice(1);
      const ok = !!document.getElementById(id);
      const li = a.closest("li");
      if (li && (a.closest("nav") || a.closest("footer"))) li.hidden = !ok;
      else a.setAttribute("href", ok ? `#${id}` : `#${["close", "contact", "top"].find((x) => document.getElementById(x))}`);
    }
    applyTexts();
    applyMedia();
    // the studio lists the visible image slots so they can be filled from the panel too
    post({
      type: "studio:slots",
      slots: [...new Set(Array.from(main.querySelectorAll<HTMLElement>("[data-block]:not([hidden]) [data-slot]")).map((m) => m.dataset.slot!))],
    });
    document.documentElement.toggleAttribute("data-editing", !!next.editing);
    document.documentElement.dataset.studio = next.selection.page;
  }

  // ---------------------------------------------------------------- editing on the page
  function startEdit(el: HTMLElement) {
    if (active === el) return;
    active?.blur();
    active = el;
    try {
      el.contentEditable = "plaintext-only";
    } catch {
      el.contentEditable = "true";
    }
    el.focus();
    getSelection()?.selectAllChildren(el);
    const before = el.textContent;
    const done = (commit: boolean) => {
      el.removeEventListener("keydown", onKey);
      el.removeEventListener("blur", onBlur);
      el.removeAttribute("contenteditable");
      active = null;
      const k = el.dataset.k!;
      const value = norm(el.textContent);
      if (!commit || !value) el.textContent = before;
      else {
        const edited = value === base(k) ? null : value;
        const content = { ...state.content };
        if (edited === null) delete content[k];
        else content[k] = edited;
        state = { ...state, content };
        post({ type: "studio:text", lang, key: k, value: edited });
      }
      applyTexts();
    };
    const onKey = (e: KeyboardEvent) => {
      if (e.key === "Enter" && !e.shiftKey) {
        e.preventDefault();
        el.blur();
      } else if (e.key === "Escape") {
        e.preventDefault();
        el.removeEventListener("blur", onBlur);
        done(false);
      }
    };
    const onBlur = () => done(true);
    el.addEventListener("keydown", onKey);
    el.addEventListener("blur", onBlur);
  }

  const picker = document.createElement("input");
  picker.type = "file";
  picker.accept = "image/*";
  picker.hidden = true;
  document.body.append(picker);
  let pickSlot = "";
  picker.addEventListener("change", () => {
    const file = picker.files?.[0];
    if (file && pickSlot) post({ type: "studio:media", slot: pickSlot, file });
    picker.value = "";
  });

  document.addEventListener(
    "click",
    (e) => {
      if (!state.editing) return;
      const t = e.target as HTMLElement;
      if (t.closest("[contenteditable]")) {
        // placing the caret inside an editable link or button must not follow or press it
        if (t.closest("a, button, summary, label")) e.preventDefault();
        return;
      }
      const leaf = t.closest<HTMLElement>("[data-k]");
      const slot = t.closest<HTMLElement>("[data-slot]");
      if (!leaf && !slot && !t.closest("a, button, summary, label")) return;
      // in edit mode a click edits; it never navigates, submits or toggles
      e.preventDefault();
      e.stopPropagation();
      if (leaf) startEdit(leaf);
      else if (slot) {
        pickSlot = slot.dataset.slot!;
        picker.click();
      }
    },
    true,
  );

  // ---------------------------------------------------------------- snapshot for the build brief
  function snapshot(): Snapshot {
    const shown = (el: Element) => !el.closest("[data-block][hidden], li[hidden]");
    const item = (el: HTMLElement): SnapItem => ({
      role: el.classList.contains("lk-btn__label") ? "btn" : el.closest(".lk-eyebrow") ? "eyebrow" : el.tagName.toLowerCase(),
      text: norm(el.textContent),
      // typed in the studio, or the business name standing in for the placeholder name
      edited: (!!state.content && el.dataset.k! in state.content) || (!!state.name && norm(el.textContent) === state.name),
    });
    const within = (root: Element | null) => (root ? leaves.filter((l) => root.contains(l) && shown(l)).map(item) : []);
    return {
      lang,
      header: within(document.querySelector("header")),
      footer: within(document.querySelector("footer")),
      sections: Array.from(main.querySelectorAll<HTMLElement>("[data-block]:not([hidden])")).map((w) => ({
        block: w.dataset.block!,
        variant: w.dataset.variant!,
        tone: w.querySelector(w.dataset.toneTarget ?? "section")?.getAttribute("data-tone") ?? "base",
        items: within(w),
        slots: Array.from(w.querySelectorAll<HTMLElement>("[data-slot]")).map((m) => m.dataset.slot!),
      })),
    };
  }

  // ---------------------------------------------------------------- wiring
  window.addEventListener("message", (e) => {
    if (e.origin !== location.origin) return;
    if (e.data?.type === "studio:apply") {
      apply(e.data as Apply);
      history.replaceState(null, "", encodeSelection(e.data.selection, e.data.tweaks ?? {}) + location.hash);
    } else if (e.data?.type === "studio:snapshot") {
      post({ type: "studio:snapshot", id: e.data.id, snapshot: snapshot() });
    }
  });

  async function boot() {
    const q = new URLSearchParams(location.search);
    const id = q.get("project");
    const project = id && !embedded ? await getProject(id) : undefined;
    if (project) {
      apply({
        selection: project.selection,
        tweaks: project.tweaks,
        sections: project.sections,
        content: project.content[lang],
        name: nameFor(project.info, lang),
        media: await mediaUrls(project),
      });
    } else {
      const initial = decodeState(location.search);
      apply({ selection: initial.selection, tweaks: initial.tweaks });
    }
    post({ type: "studio:ready" });
  }
  boot();
</script>

<style is:global>
  @layer site {
    .studio-note {
      font-size: var(--step--1);
      color: var(--tone-fg-muted);
    }
    [data-slot] {
      position: relative;
    }
    .studio-img {
      position: absolute;
      inset: 0;
      z-index: 2;
      inline-size: 100%;
      block-size: 100%;
      object-fit: cover;
      border-radius: inherit;
    }
    .rlogo[data-filled] > svg {
      display: none;
    }
    .rlogo[data-filled] .rlogo__name {
      position: absolute;
      clip-path: inset(50%);
      inline-size: 1px;
      block-size: 1px;
      overflow: hidden;
      white-space: nowrap;
    }
    .rlogo > .studio-img {
      position: static;
      inline-size: auto;
      max-inline-size: 10rem;
      block-size: 2.25rem;
      object-fit: contain;
      border-radius: 0;
    }
    /* edit mode: everything editable shows itself on hover */
    [data-editing] [data-k] {
