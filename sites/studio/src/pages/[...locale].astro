---
/**
 * The style studio: one project per client. Style (ready-made styles, picture cards, fine-tuning),
 * sections (order, variant, background), content (the business facts, logo, images, and any text
 * edited directly on the preview), and a handoff that produces the build brief and project file.
 * The client logic lives in src/studio/app.ts. Private tool — not indexed.
 */
import BaseLayout from "@landing/kit/layouts/BaseLayout.astro";
import Dialog from "@landing/kit/components/Dialog.astro";
import Button from "@landing/kit/components/Button.astro";
import Icon from "@landing/kit/primitives/Icon.astro";
import LocaleSwitch from "@landing/kit/components/LocaleSwitch.astro";
import { localeHref, localePaths } from "@landing/kit/i18n";
import { site, type Locale } from "../site";
import Tabs from "@landing/kit/components/Tabs.astro";
import { BLOCKS, DEFAULT_SELECTION, ELEMENTS, ELEMENT_INFO, HEROES, PRESETS, TONES, TWEAKS, buildBrand, type ElementKey } from "../studio/options";
import { INFO_GROUPS } from "../studio/project";
import { PALETTES } from "../studio/palettes";
import { FONT_FAMILIES, cssVar } from "../studio/fonts";
import ChoiceArt from "../components/ChoiceArt.astro";
import "../styles/shell.css";

export const getStaticPaths = () => localePaths(site);

const { locale } = Astro.props as { locale: Locale };
const ar = locale === "ar";
const t = ar
  ? {
      title: "استوديو الأنماط",
