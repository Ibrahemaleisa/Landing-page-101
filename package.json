{
  "name": "landing-kit-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "pnpm --filter",
    "build": "pnpm -r --filter \"./sites/*\" build",
    "check": "pnpm -r --filter \"./sites/*\" --filter \"./packages/*\" check",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "e2e": "playwright test",
    "perf": "node scripts/perf/run.mjs",
    "new-site": "node packages/create-landing/bin/create-landing.mjs",
    "verify": "pnpm lint && pnpm check && pnpm test && pnpm build && pnpm e2e"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@landing/kit": "workspace:*",
    "@playwright/test": "1.63.0",
    "@types/node": "^22.20.5",
    "@typescript-eslint/parser": "8.72.1",
    "astro-eslint-parser": "^3.2.0",
    "chrome-launcher": "^1.2.2",
    "eslint": "10.13.0",
    "eslint-plugin-astro": "3.2.1",
    "eslint-plugin-jsx-a11y-x": "^0.2.0",
    "globals": "^17.13.0",
    "lighthouse": "13.6.0",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.0.5"
  }
}
