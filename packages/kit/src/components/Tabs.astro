---
/**
 * WAI-ARIA Tabs (automatic activation, roving tabindex, ←/→ follow reading direction, Home/End).
 * Panels are named slots: `<div slot="panel-<id>">`. Without JavaScript every panel renders in
 * order under its own heading, so no content is lost.
 */
export interface TabDef {
  id: string;
  label: string;
}

export interface Props {
  tabs: TabDef[];
  /** Accessible name of the tab list. */
  label: string;
  /** Prefix that keeps ids unique when several tab sets share a page. */
  idPrefix?: string;
  variant?: "underline" | "pill";
  class?: string;
}

const { tabs, label, idPrefix = "tabs", variant = "underline", class: cls } = Astro.props;
const panels = await Promise.all(tabs.map((t) => Astro.slots.render(`panel-${t.id}`)));
---

<div class:list={["lk-tabs", cls]} data-lk-tabs data-variant={variant}>
  <div class="lk-tabs__list" role="tablist" aria-label={label} hidden>
    {tabs.map((t, i) => (
      <button
        type="button"
        role="tab"
        id={`${idPrefix}-tab-${t.id}`}
        aria-controls={`${idPrefix}-panel-${t.id}`}
        aria-selected={i === 0 ? "true" : "false"}
        tabindex={i === 0 ? 0 : -1}
        class="lk-tabs__tab"
      >
        {t.label}
      </button>
    ))}
  </div>
  {tabs.map((t, i) => (
    <div class="lk-tabs__panel" role="tabpanel" tabindex="0" id={`${idPrefix}-panel-${t.id}`} aria-labelledby={`${idPrefix}-tab-${t.id}`} data-index={i}>
      <p class="lk-tabs__fallback-title lk-eyebrow">{t.label}</p>
      <Fragment set:html={panels[i]} />
    </div>
  ))}
</div>

<script>
  // Enhances every tab set on the page. Before this runs, all panels are visible.
  function init(root: HTMLElement) {
    const list = root.querySelector<HTMLElement>('[role="tablist"]');
    if (!list) return;
    const tabs = Array.from(list.querySelectorAll<HTMLButtonElement>('[role="tab"]'));
    const panels = tabs.map((t) => document.getElementById(t.getAttribute("aria-controls")!)!);

    const select = (index: number, focus: boolean) => {
      tabs.forEach((tab, i) => {
        const on = i === index;
        tab.setAttribute("aria-selected", String(on));
        tab.tabIndex = on ? 0 : -1;
        panels[i].hidden = !on;
      });
      if (focus) tabs[index].focus();
    };

    tabs.forEach((tab, i) => {
      tab.addEventListener("click", () => select(i, false));
      tab.addEventListener("keydown", (e) => {
        const rtl = getComputedStyle(root).direction === "rtl";
        const next = rtl ? "ArrowLeft" : "ArrowRight";
        const prev = rtl ? "ArrowRight" : "ArrowLeft";
        let to: number | null = null;
        if (e.key === next) to = (i + 1) % tabs.length;
        else if (e.key === prev) to = (i - 1 + tabs.length) % tabs.length;
        else if (e.key === "Home") to = 0;
        else if (e.key === "End") to = tabs.length - 1;
        if (to !== null) {
          e.preventDefault();
          select(to, true);
        }
      });
    });

    list.hidden = false;
    root.dataset.enhanced = "";
    select(0, false);
  }

  document.querySelectorAll<HTMLElement>("[data-lk-tabs]:not([data-enhanced])").forEach(init);
</script>

<style>
  @layer components {
    .lk-tabs__list {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-2xs);
      margin-block-end: var(--space-m);
    }
    .lk-tabs__tab {
      min-block-size: 2.75rem;
      padding: 0.5em 1em;
      border: 0;
      background: none;
      color: var(--tone-fg-muted);
      font-family: var(--font-control);
      font-weight: var(--control-weight);
      letter-spacing: var(--control-tracking);
      text-transform: var(--control-transform);
      transition:
        color var(--motion-fast) var(--motion-ease),
        background-color var(--motion-fast) var(--motion-ease),
        box-shadow var(--motion-fast) var(--motion-ease);
    }
    .lk-tabs__tab:hover {
      color: var(--tone-fg);
    }
    .lk-tabs[data-variant="underline"] .lk-tabs__list {
      border-block-end: var(--border-width) solid var(--tone-line);
      gap: var(--space-s);
    }
    .lk-tabs[data-variant="underline"] .lk-tabs__tab {
      padding-inline: 0;
      box-shadow: inset 0 -2px 0 transparent;
    }
    .lk-tabs[data-variant="underline"] .lk-tabs__tab[aria-selected="true"] {
      color: var(--tone-fg);
      box-shadow: inset 0 -3px 0 var(--tone-accent-text);
    }
    .lk-tabs[data-variant="pill"] .lk-tabs__list {
      display: inline-flex;
      padding: 0.25rem;
      border: var(--border-width) solid var(--tone-line);
      border-radius: var(--radius-control);
      background: var(--tone-surface);
    }
    .lk-tabs[data-variant="pill"] .lk-tabs__tab {
      border-radius: calc(var(--radius-control) - 0.25rem);
      color: var(--tone-surface-fg-muted);
    }
    .lk-tabs[data-variant="pill"] .lk-tabs__tab[aria-selected="true"] {
      background: var(--tone-accent);
      color: var(--tone-on-accent);
    }
    .lk-tabs__panel + .lk-tabs__panel {
      margin-block-start: var(--space-l);
    }
    .lk-tabs[data-enhanced] .lk-tabs__panel + .lk-tabs__panel {
      margin-block-start: 0;
    }
    .lk-tabs[data-enhanced] .lk-tabs__fallback-title {
      display: none;
    }
    .lk-tabs__fallback-title {
      margin-block-end: var(--space-xs);
    }
    .lk-tabs__panel:focus-visible {
      outline-offset: 6px;
    }
  }
</style>
