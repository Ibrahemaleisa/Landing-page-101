---
/**
 * Site header with desktop navigation and a modal mobile menu on native `<dialog>`.
 *
 * Modes:
 *  - `sticky`: solid bar that stays at the top (default).
 *  - `overlay`: transparent over the first section, turning solid as the page scrolls (CSS
 *    scroll timeline; solid where unsupported). Pair with a hero that sets `underHeader`.
 *  - `static`: scrolls away with the page.
 */
import type { SiteConfig } from "../i18n";
import type { Action } from "../types";
import Button from "./Button.astro";
import Icon from "../primitives/Icon.astro";
import LocaleSwitch from "./LocaleSwitch.astro";

export interface Props {
  site: SiteConfig;
  locale: string;
  path?: string;
  /** Link for the logo (usually the locale's home). */
  homeHref: string;
  /**
   * Accessible name of the home link. It must contain the logo's visible text (WCAG 2.5.3 Label
   * in Name), e.g. "Kitebase — home" for a "kitebase" wordmark, also in other languages.
   */
  homeLabel: string;
  links: { href: string; label: string }[];
  cta?: Action;
  /** Secondary action, e.g. "Sign in". */
  secondary?: Action;
  mode?: "sticky" | "overlay" | "static";
  tone?: string;
  labels: { nav: string; menu: string; close: string; language: string };
}

const { site, locale, path = "/", homeHref, homeLabel, links, cta, secondary, mode = "sticky", tone, labels } = Astro.props;
// rendered once, reused in the bar and the menu sheet
const logo = await Astro.slots.render("logo");
---

<header class="lk-header" data-mode={mode} data-tone={tone}>
  <div class="lk-container lk-header__bar">
    <a href={homeHref} class="lk-header__home" aria-label={homeLabel}>
      <Fragment set:html={logo} />
    </a>
    <nav class="lk-header__nav" aria-label={labels.nav}>
      <ul role="list">
        {links.map((l) => (
          <li>
            <a href={l.href}>{l.label}</a>
          </li>
        ))}
      </ul>
    </nav>
    <div class="lk-header__actions">
      <LocaleSwitch site={site} locale={locale} path={path} label={labels.language} class="lk-header__locale" />
      {secondary && (
        <Button href={secondary.href} variant={secondary.variant ?? "ghost"} size="sm" class="lk-header__secondary">
          {secondary.label}
        </Button>
      )}
      {cta && (
        <Button href={cta.href} variant={cta.variant ?? "primary"} size="sm" icon={cta.icon} class="lk-header__cta">
          {cta.label}
        </Button>
      )}
      <button type="button" class="lk-header__menu" data-lk-menu-open aria-haspopup="dialog" aria-controls="lk-mnav" aria-expanded="false">
        <Icon name="menu" size="1.5rem" />
        <span class="lk-visually-hidden">{labels.menu}</span>
      </button>
    </div>
  </div>

  <dialog id="lk-mnav" class="lk-mnav" aria-label={labels.menu} data-tone={tone}>
    <div class="lk-container lk-mnav__bar">
      <a href={homeHref} class="lk-header__home" aria-label={homeLabel}>
        <Fragment set:html={logo} />
      </a>
      <button type="button" class="lk-header__menu" data-lk-menu-close>
        <Icon name="x" size="1.5rem" />
        <span class="lk-visually-hidden">{labels.close}</span>
      </button>
    </div>
    <nav class="lk-container lk-mnav__nav" aria-label={labels.nav}>
      <ul role="list">
        {links.map((l, i) => (
          <li class="lk-enter" style={`--lk-delay:${i * 30}ms`}>
            <a href={l.href} data-lk-menu-link>
              {l.label}
            </a>
          </li>
        ))}
      </ul>
      <div class="lk-mnav__foot">
        <LocaleSwitch site={site} locale={locale} path={path} label={labels.language} />
        <div class="lk-mnav__actions">
          {secondary && (
            <Button href={secondary.href} variant="secondary" block>
              {secondary.label}
            </Button>
          )}
          {cta && (
            <Button href={cta.href} variant="primary" icon={cta.icon} block>
              {cta.label}
            </Button>
          )}
        </div>
      </div>
    </nav>
  </dialog>
</header>

<script>
  const dialog = document.getElementById("lk-mnav") as HTMLDialogElement | null;
  const opener = document.querySelector<HTMLButtonElement>("[data-lk-menu-open]");
  if (dialog && opener && typeof dialog.showModal === "function") {
    opener.addEventListener("click", () => {
      dialog.showModal();
      opener.setAttribute("aria-expanded", "true");
    });
    dialog.querySelector("[data-lk-menu-close]")?.addEventListener("click", () => dialog.close());
    // in-page links: close first so the page can scroll to the target
    // ...and don't pull focus (and the scroll position) back to the menu button afterwards
    let viaLink = false;
    dialog.querySelectorAll("[data-lk-menu-link]").forEach((a) =>
      a.addEventListener("click", () => {
        viaLink = true;
        dialog.close();
      }),
    );
    dialog.addEventListener("close", () => {
      opener.setAttribute("aria-expanded", "false");
      if (!viaLink) opener.focus({ preventScroll: true });
      viaLink = false;
    });
    // the menu is for small screens only; never leave it open past the breakpoint
    matchMedia("(min-width: 64rem)").addEventListener("change", (e) => e.matches && dialog.open && dialog.close());
  }
</script>

<style>
  @layer components {
    .lk-header {
      z-index: 50;
      inset-block-start: 0;
      inset-inline: 0;
      background-color: var(--tone-bg);
      color: var(--tone-fg);
      border-block-end: var(--border-width) solid var(--tone-line);
    }
    .lk-header[data-mode="sticky"] {
      position: sticky;
    }
    .lk-header[data-mode="overlay"] {
      position: fixed;
    }
    @supports (animation-timeline: scroll()) {
      .lk-header[data-mode="overlay"] {
        animation: lk-header-solid linear both;
        animation-timeline: scroll(root);
        animation-range: 0 8rem;
      }
    }
    @keyframes lk-header-solid {
      from {
        background-color: transparent;
        border-block-end-color: transparent;
      }
    }
    .lk-header__bar,
    .lk-mnav__bar {
      display: flex;
      align-items: center;
      gap: var(--space-s);
      block-size: var(--header-height);
    }
    .lk-header__home {
      display: inline-flex;
      align-items: center;
      min-block-size: 2.75rem;
      border-radius: var(--radius-control);
      color: inherit;
      text-decoration: none;
    }
    .lk-header__nav {
      display: none;
      margin-inline-start: auto;
    }
    .lk-header__nav ul {
      display: flex;
      gap: var(--space-2xs);
    }
    .lk-header__nav a {
      display: inline-flex;
      align-items: center;
      min-block-size: 2.75rem;
      padding-inline: 0.75em;
      border-radius: var(--radius-control);
      color: var(--tone-fg);
      font-size: var(--step--1);
      font-weight: var(--control-weight);
      text-decoration: none;
    }
    .lk-header__nav a:hover {
      text-decoration: underline;
      text-underline-offset: 0.35em;
    }
    .lk-header__actions {
      display: flex;
      align-items: center;
      gap: var(--space-xs);
      margin-inline-start: auto;
    }
    .lk-header__menu {
      display: grid;
      place-items: center;
      inline-size: 2.75rem;
      block-size: 2.75rem;
      border: 0;
      border-radius: var(--radius-control);
      background: none;
      color: inherit;
    }
    .lk-header :global(.lk-header__locale),
    .lk-header :global(.lk-header__secondary) {
      display: none;
    }
    @media (min-width: 40rem) {
      .lk-header :global(.lk-header__locale) {
        display: inline-flex;
      }
    }
    @media (max-width: 23.99rem) {
      .lk-header :global(.lk-header__cta) {
        display: none;
      }
    }
    @media (min-width: 64rem) {
      .lk-header__nav {
        display: block;
      }
      .lk-header__actions {
        margin-inline-start: var(--space-s);
      }
      .lk-header :global(.lk-header__secondary) {
        display: inline-flex;
      }
      .lk-header__actions > .lk-header__menu {
        display: none;
      }
    }

    /* mobile menu: a full-screen modal sheet */
    .lk-mnav {
      inline-size: 100%;
      block-size: 100%;
      margin: 0;
      background: var(--tone-bg);
      color: var(--tone-fg);
    }
    .lk-mnav::backdrop {
      background: var(--tone-bg);
    }
    .lk-mnav__bar {
      justify-content: space-between;
      border-block-end: var(--border-width) solid var(--tone-line);
    }
    .lk-mnav__nav {
      display: flex;
      flex-direction: column;
      min-block-size: calc(100dvh - var(--header-height));
      padding-block: var(--space-m);
    }
    .lk-mnav__nav ul {
      display: grid;
    }
    .lk-mnav__nav li a {
      display: block;
      padding-block: var(--space-xs);
      border-block-end: var(--border-width) solid var(--tone-line);
      font-family: var(--font-display);
      font-size: var(--step-3);
      font-weight: var(--weight-heading);
      letter-spacing: var(--tracking-heading);
      color: inherit;
      text-decoration: none;
    }
    .lk-mnav__foot {
      display: grid;
      gap: var(--space-s);
      margin-block-start: auto;
      padding-block-start: var(--space-l);
    }
    .lk-mnav__actions {
      display: grid;
      gap: var(--space-xs);
    }
  }
</style>
