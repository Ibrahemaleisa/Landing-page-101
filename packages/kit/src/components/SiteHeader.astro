---
/**
 * Site header with desktop navigation and a modal mobile menu on native `<dialog>`.
 *
 * Modes:
 *  - `sticky`: solid bar that stays at the top (default).
 *  - `overlay`: transparent over the first section, turning solid as the page scrolls (CSS
 *    scroll timeline; solid where unsupported). Pair with a hero that sets `underHeader`.
 *  - `static`: scrolls away with the page.
 *  - `hide`: sticky, but slides away while scrolling down and returns on the way up.
 *
 * Desktop arrangement (`layout`): `standard` (logo, then navigation at the end), `start` (navigation
 * next to the logo), `centered` (logo in the middle), `stacked` (navigation on a second row),
 * `minimal` (menu button only, at every size). `look`: `solid`, `clean` (no rule), `glass`
 * (translucent blur), `floating` (a rounded bar inset from the edges), `transparent` (no ground
 * until the page scrolls). `nav`: link style.
 */
import type { SiteConfig } from "../i18n";
import type { Action } from "../types";
import Button from "./Button.astro";
import Icon from "../primitives/Icon.astro";
import LocaleSwitch from "./LocaleSwitch.astro";

export interface Props {
  site: SiteConfig;
  locale: string;
  path?: string;
  /** Link for the logo (usually the locale's home). */
  homeHref: string;
  /**
   * Accessible name of the home link. It must contain the logo's visible text (WCAG 2.5.3 Label
   * in Name), e.g. "Kitebase — home" for a "kitebase" wordmark, also in other languages.
   */
  homeLabel: string;
  links: { href: string; label: string }[];
  cta?: Action;
  /** Secondary action, e.g. "Sign in". */
  secondary?: Action;
  mode?: "sticky" | "overlay" | "static" | "hide";
  layout?: "standard" | "start" | "centered" | "stacked" | "minimal";
  look?: "solid" | "clean" | "glass" | "floating" | "transparent";
  nav?: "plain" | "underline" | "pill" | "caps";
  tone?: string;
  labels: { nav: string; menu: string; close: string; language: string };
}

const {
  site,
  locale,
  path = "/",
  homeHref,
  homeLabel,
  links,
  cta,
  secondary,
  mode = "sticky",
  layout = "standard",
  look = "solid",
  nav = "plain",
  tone,
  labels,
} = Astro.props;
// rendered once, reused in the bar and the menu sheet
const logo = await Astro.slots.render("logo");
---

<header class="lk-header" data-mode={mode} data-layout={layout} data-look={look} data-nav={nav} data-tone={tone}>
  <div class="lk-container lk-header__bar">
    <a href={homeHref} class="lk-header__home" aria-label={homeLabel}>
      <Fragment set:html={logo} />
    </a>
    <nav class="lk-header__nav" aria-label={labels.nav}>
      <ul role="list">
        {links.map((l) => (
          <li>
            <a href={l.href}>{l.label}</a>
          </li>
        ))}
      </ul>
    </nav>
    <div class="lk-header__actions">
      <LocaleSwitch site={site} locale={locale} path={path} label={labels.language} class="lk-header__locale" />
      {secondary && (
        <Button href={secondary.href} variant={secondary.variant ?? "ghost"} size="sm" class="lk-header__secondary">
          {secondary.label}
        </Button>
      )}
      {cta && (
        <Button href={cta.href} variant={cta.variant ?? "primary"} size="sm" icon={cta.icon} class="lk-header__cta">
          {cta.label}
        </Button>
      )}
      <button type="button" class="lk-header__menu" data-lk-menu-open aria-haspopup="dialog" aria-controls="lk-mnav" aria-expanded="false">
        <Icon name="menu" size="1.5rem" />
        <span class="lk-visually-hidden">{labels.menu}</span>
      </button>
    </div>
  </div>

  <dialog id="lk-mnav" class="lk-mnav" aria-label={labels.menu} data-tone={tone}>
    <div class="lk-container lk-mnav__bar">
      <a href={homeHref} class="lk-header__home" aria-label={homeLabel}>
        <Fragment set:html={logo} />
      </a>
      <button type="button" class="lk-header__menu" data-lk-menu-close>
        <Icon name="x" size="1.5rem" />
        <span class="lk-visually-hidden">{labels.close}</span>
      </button>
    </div>
    <div class="lk-container lk-mnav__nav">
      <nav aria-label={labels.nav}>
        <ul role="list">
          {links.map((l, i) => (
            <li class="lk-enter" style={`--lk-delay:${i * 30}ms`}>
              <a href={l.href} data-lk-menu-link>
                {l.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
      <div class="lk-mnav__foot">
        <LocaleSwitch site={site} locale={locale} path={path} label={labels.language} />
        <div class="lk-mnav__actions">
          {secondary && (
            <Button href={secondary.href} variant="secondary" block data-lk-menu-link>
              {secondary.label}
            </Button>
          )}
          {cta && (
            <Button href={cta.href} variant="primary" icon={cta.icon} block data-lk-menu-link>
              {cta.label}
            </Button>
          )}
        </div>
      </div>
    </div>
  </dialog>
</header>

<script>
  const dialog = document.getElementById("lk-mnav") as HTMLDialogElement | null;
  const opener = document.querySelector<HTMLButtonElement>("[data-lk-menu-open]");
  if (dialog && opener && typeof dialog.showModal === "function") {
    opener.addEventListener("click", () => {
      dialog.showModal();
      opener.setAttribute("aria-expanded", "true");
    });
    dialog.querySelector("[data-lk-menu-close]")?.addEventListener("click", () => dialog.close());
    // In-page links: close the menu, then move focus to the target itself, so the next Tab
    // continues from the chosen section instead of from the menu button (WCAG 2.4.3).
    let target: HTMLElement | null = null;
    dialog.querySelectorAll<HTMLAnchorElement>("[data-lk-menu-link]").forEach((a) =>
      a.addEventListener("click", (e) => {
        const href = a.getAttribute("href") ?? "";
        const el = href.startsWith("#") && href.length > 1 ? document.getElementById(decodeURIComponent(href.slice(1))) : null;
        if (!el) return dialog.close(); // other pages: let the browser navigate
        e.preventDefault();
        target = el;
        dialog.close();
      }),
    );
    dialog.addEventListener("close", () => {
      opener.setAttribute("aria-expanded", "false");
      if (target) {
        const el = target;
        target = null;
        if (!el.hasAttribute("tabindex")) el.setAttribute("tabindex", "-1");
        el.focus({ preventScroll: true });
        el.scrollIntoView({ block: "start", behavior: matchMedia("(prefers-reduced-motion: reduce)").matches ? "auto" : "smooth" });
        history.pushState(null, "", `#${el.id}`);
      } else {
        opener.focus({ preventScroll: true });
      }
    });
    // the menu is for small screens only (unless the header is minimal); never leave it open past the breakpoint
    matchMedia("(min-width: 64rem)").addEventListener(
      "change",
      (e) => e.matches && dialog.open && dialog.closest<HTMLElement>(".lk-header")?.dataset.layout !== "minimal" && dialog.close(),
    );
  }

  // mode="hide": slide away while scrolling down, come back on the way up or when focused
  const header = document.querySelector<HTMLElement>(".lk-header");
  if (header) {
    let last = scrollY;
    addEventListener(
      "scroll",
      () => {
        if (header.dataset.mode !== "hide") return header.removeAttribute("data-hidden");
        const y = scrollY;
        if (Math.abs(y - last) < 6) return;
        header.toggleAttribute("data-hidden", y > last && y > header.offsetHeight * 2 && !header.contains(document.activeElement));
        last = y;
      },
      { passive: true },
    );
    header.addEventListener("focusin", () => header.removeAttribute("data-hidden"));
  }
</script>

<style>
  @layer components {
    .lk-header {
      z-index: 50;
      inset-block-start: 0;
      inset-inline: 0;
      background-color: var(--tone-bg);
      color: var(--tone-fg);
      border-block-end: var(--border-width) solid var(--tone-line);
    }
    .lk-header[data-mode="sticky"] {
      position: sticky;
    }
    .lk-header[data-mode="overlay"] {
      position: fixed;
    }
    @supports (animation-timeline: scroll()) {
      .lk-header[data-mode="overlay"] {
        animation: lk-header-solid linear both;
        animation-timeline: scroll(root);
        animation-range: 0 8rem;
      }
    }
    @keyframes lk-header-solid {
      from {
        background-color: transparent;
        border-block-end-color: transparent;
      }
    }
    .lk-header__bar,
    .lk-mnav__bar {
      display: flex;
      align-items: center;
      gap: var(--space-s);
      block-size: var(--header-height);
    }
    .lk-header__home {
      display: inline-flex;
      align-items: center;
      min-block-size: 2.75rem;
      border-radius: var(--radius-control);
      color: inherit;
      text-decoration: none;
    }
    .lk-header__nav {
      display: none;
      margin-inline-start: auto;
    }
    .lk-header__nav ul {
      display: flex;
      gap: var(--space-2xs);
    }
    .lk-header__nav a {
      display: inline-flex;
      align-items: center;
      min-block-size: 2.75rem;
      padding-inline: 0.75em;
      border-radius: var(--radius-control);
      color: var(--tone-fg);
      font-size: var(--step--1);
      font-weight: var(--control-weight);
      text-decoration: none;
    }
    .lk-header__nav a:hover {
      text-decoration: underline;
      text-underline-offset: 0.35em;
    }
    .lk-header__actions {
      display: flex;
      align-items: center;
      gap: var(--space-xs);
      margin-inline-start: auto;
    }
    .lk-header__menu {
      display: grid;
      place-items: center;
      inline-size: 2.75rem;
      block-size: 2.75rem;
      border: 0;
      border-radius: var(--radius-control);
      background: none;
      color: inherit;
    }
    .lk-header :global(.lk-header__locale),
    .lk-header :global(.lk-header__secondary) {
      display: none;
    }
    @media (min-width: 40rem) {
      .lk-header :global(.lk-header__locale) {
        display: inline-flex;
      }
    }
    @media (max-width: 23.99rem) {
      .lk-header :global(.lk-header__cta) {
        display: none;
      }
    }
    @media (min-width: 64rem) {
      .lk-header__nav {
        display: block;
      }
      .lk-header__actions {
        margin-inline-start: var(--space-s);
      }
      .lk-header :global(.lk-header__secondary) {
        display: inline-flex;
      }
      .lk-header__actions > .lk-header__menu {
        display: none;
      }
    }

    /* ---------------------------------------------------------------- behaviour */
    .lk-header[data-mode="hide"] {
      position: sticky;
      transition: transform var(--motion-base) var(--motion-ease);
    }
    .lk-header[data-mode="hide"][data-hidden] {
      transform: translateY(-100%);
    }

    /* ---------------------------------------------------------------- looks */
    .lk-header[data-look="clean"] {
      border-block-end-color: transparent;
    }
    .lk-header[data-look="glass"] {
      background-color: color-mix(in srgb, var(--tone-bg) 78%, transparent);
      backdrop-filter: blur(14px) saturate(1.4);
      -webkit-backdrop-filter: blur(14px) saturate(1.4);
    }
    .lk-header[data-look="floating"] {
      border-block-end-color: transparent;
      background: transparent;
      padding-block-start: 0.6rem;
    }
    .lk-header[data-look="floating"] .lk-header__bar {
      /* the container's gutter becomes the gap around the bar */
      inline-size: calc(100% - 2 * var(--gutter));
      max-inline-size: var(--container);
      block-size: calc(var(--header-height) - 0.6rem);
      padding-inline: var(--space-s) var(--space-xs);
      border: var(--border-width) solid var(--tone-line);
      border-radius: calc(var(--radius-card) + 0.5rem);
      background: var(--tone-bg);
      box-shadow: var(--shadow-raised);
    }
    .lk-header[data-look="transparent"] {
      background-color: transparent;
      border-block-end-color: transparent;
    }
    @supports (animation-timeline: scroll()) {
      .lk-header[data-look="transparent"] {
        background-color: var(--tone-bg);
        border-block-end-color: var(--tone-line);
        animation: lk-header-solid linear both;
        animation-timeline: scroll(root);
        animation-range: 0 8rem;
      }
    }

    /* ---------------------------------------------------------------- link styles */
    .lk-header[data-nav="underline"] .lk-header__nav a {
      text-decoration: underline;
      text-decoration-color: transparent;
      text-decoration-thickness: 2px;
      text-underline-offset: 0.45em;
    }
    .lk-header[data-nav="underline"] .lk-header__nav a:hover {
      text-decoration-color: var(--tone-accent);
    }
    .lk-header[data-nav="pill"] .lk-header__nav a {
      border-radius: 999px;
    }
    .lk-header[data-nav="pill"] .lk-header__nav a:hover {
      background: var(--tone-surface);
      color: var(--tone-surface-fg);
      text-decoration: none;
    }
    .lk-header[data-nav="caps"] .lk-header__nav a {
      font-size: max(var(--step--2), 0.75rem);
      letter-spacing: 0.1em;
      text-transform: uppercase;
    }
    .lk-header[data-nav="caps"] .lk-header__nav a:lang(ar) {
      font-size: var(--step--1);
      letter-spacing: 0;
    }

    /* ---------------------------------------------------------------- layouts */
    .lk-header[data-layout="centered"] .lk-header__bar {
      display: grid;
      grid-template-columns: 1fr auto 1fr;
    }
    .lk-header[data-layout="centered"] .lk-header__home {
      grid-column: 2;
      grid-row: 1;
    }
    .lk-header[data-layout="centered"] .lk-header__nav {
      grid-column: 1;
      grid-row: 1;
      margin: 0;
    }
    .lk-header[data-layout="centered"] .lk-header__actions {
      grid-column: 3;
      grid-row: 1;
      justify-self: end;
    }
    .lk-header[data-layout="minimal"] .lk-header__nav {
      display: none !important;
    }
    @media (min-width: 64rem) {
      .lk-header[data-layout="start"] .lk-header__nav {
        margin-inline-start: var(--space-l);
      }
      .lk-header[data-layout="start"] .lk-header__actions {
        margin-inline-start: auto;
      }
      .lk-header[data-layout="stacked"] .lk-header__bar {
        flex-wrap: wrap;
        block-size: auto;
        row-gap: 0;
        padding-block-start: var(--space-2xs);
      }
      .lk-header[data-layout="stacked"] .lk-header__home {
        min-block-size: calc(var(--header-height) - var(--space-2xs));
      }
      .lk-header[data-layout="stacked"] .lk-header__nav {
        order: 3;
        flex-basis: 100%;
        margin: 0;
        border-block-start: var(--border-width) solid var(--tone-line);
      }
      .lk-header[data-layout="stacked"] .lk-header__nav ul {
        justify-content: center;
      }
      .lk-header[data-layout="minimal"] .lk-header__actions > .lk-header__menu {
        display: grid;
      }
    }
    @media (prefers-reduced-motion: reduce) {
      .lk-header[data-mode="hide"] {
        transition: none;
      }
    }

    /* mobile menu: a full-screen modal sheet */
    .lk-mnav {
      inline-size: 100%;
      block-size: 100%;
      margin: 0;
      background: var(--tone-bg);
      color: var(--tone-fg);
    }
    .lk-mnav::backdrop {
      background: var(--tone-bg);
    }
    .lk-mnav__bar {
      justify-content: space-between;
      border-block-end: var(--border-width) solid var(--tone-line);
    }
    .lk-mnav__nav {
      display: flex;
      flex-direction: column;
      min-block-size: calc(100dvh - var(--header-height));
      padding-block: var(--space-m);
    }
    .lk-mnav__nav ul {
      display: grid;
    }
    /* sections focused programmatically from the menu don't need a ring around the whole block */
    :global([tabindex="-1"]:focus:not(:focus-visible)) {
      outline: none;
    }
    .lk-mnav__nav li a {
      display: block;
      padding-block: var(--space-xs);
      border-block-end: var(--border-width) solid var(--tone-line);
      font-family: var(--font-display);
      font-size: var(--step-3);
      font-weight: var(--weight-heading);
      letter-spacing: var(--tracking-heading);
      color: inherit;
      text-decoration: none;
    }
    .lk-mnav__foot {
      display: grid;
      gap: var(--space-s);
      margin-block-start: auto;
      padding-block-start: var(--space-l);
    }
    .lk-mnav__actions {
      display: grid;
      gap: var(--space-xs);
    }
  }
</style>
