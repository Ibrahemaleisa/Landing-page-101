---
import { DIRECTIONAL, ICONS, type IconName } from "./icons";

export interface Props {
  name?: IconName;
  /** Raw SVG children (24×24 viewBox) for icons outside the set. */
  paths?: string;
  size?: number | string;
  /** Accessible name. Omit for decorative icons next to visible text. */
  label?: string;
  strokeWidth?: number;
  class?: string;
}

const { name, paths, size = "1.25em", label, strokeWidth = 1.75, class: cls } = Astro.props;
const body = paths ?? (name ? ICONS[name] : "");
const flip = name ? DIRECTIONAL.has(name) : false;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 24"
  width={size}
  height={size}
  fill="none"
  stroke="currentColor"
  stroke-width={strokeWidth}
  stroke-linecap="round"
  stroke-linejoin="round"
  class:list={["lk-icon", cls]}
  data-flip={flip ? "" : undefined}
  role={label ? "img" : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : "true"}
  focusable="false"
  set:html={body}
/>

<style>
  @layer components {
    .lk-icon {
      flex-shrink: 0;
      display: inline-block;
      vertical-align: -0.2em;
    }
  }
</style>
