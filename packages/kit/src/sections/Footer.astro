---
/**
 * Site footer: brand block, link groups, language switch and legal line.
 *
 * Layouts: `columns` (brand beside link groups, the default), `simple` (one row of links), `brand`
 * (a large wordmark above the columns), `centered` (everything on the centre line), `minimal`
 * (logo, social links and legal line only). Optional social links (icons) and contact details.
 */
import type { LinkGroup } from "../types";
import type { SiteConfig } from "../i18n";
import type { IconName } from "../primitives/icons";
import LocaleSwitch from "../components/LocaleSwitch.astro";
import Icon from "../primitives/Icon.astro";

export interface FooterLink {
  label: string;
  href: string;
  icon: IconName;
}

export interface Props {
  site: SiteConfig;
  locale: string;
  path?: string;
  tone?: string;
  tagline?: string;
  groups?: LinkGroup[];
  /** e.g. "© 2026 Opera. All rights reserved." */
  legal: string;
  layout?: "columns" | "simple" | "brand" | "centered" | "minimal";
  /** Large decorative name for the `brand` layout (hidden from assistive technology; the logo names the site). */
  wordmark?: string;
  /** Icon links to social profiles. `label` is the accessible name, e.g. "Instagram". */
  social?: FooterLink[];
  /** Phone, email, address… shown with their icons. */
  contact?: (Omit<FooterLink, "href"> & { href?: string })[];
  /** Accessible names. */
  labels: { nav: string; language: string; social?: string; contact?: string };
  class?: string;
}

const {
  site,
  locale,
  path = "/",
  tone,
  tagline,
  groups = [],
  legal,
  layout = "columns",
  wordmark,
  social = [],
  contact = [],
  labels,
  class: cls,
} = Astro.props;
---

<footer class:list={["lk-footer", cls]} data-tone={tone} data-layout={layout}>
  <div class="lk-container lk-footer__inner">
    {wordmark && (
      <p class="lk-footer__wordmark" aria-hidden="true">
        {wordmark}
      </p>
    )}
    <div class="lk-footer__brand">
      <slot name="logo" />
      {tagline && <p class="lk-footer__tagline">{tagline}</p>}
      {contact.length > 0 && (
        <ul class="lk-footer__contact" role="list" aria-label={labels.contact}>
          {contact.map((c) => (
            <li>
              <Icon name={c.icon} />
              {c.href ? <a href={c.href}>{c.label}</a> : <span>{c.label}</span>}
            </li>
          ))}
        </ul>
      )}
      {social.length > 0 && (
        <ul class="lk-footer__social" role="list" aria-label={labels.social}>
          {social.map((s) => (
            <li>
              <a href={s.href} target="_blank" rel="noopener" aria-label={s.label}>
                <Icon name={s.icon} />
              </a>
            </li>
          ))}
        </ul>
      )}
    </div>
    {groups.length > 0 && (
      <nav class="lk-footer__nav" aria-label={labels.nav}>
        {groups.map((g) => (
          <div class="lk-footer__group">
            <h2 class="lk-eyebrow lk-footer__heading">{g.title}</h2>
            <ul role="list">
              {g.links.map((l) => (
                <li>
                  <a href={l.href}>{l.label}</a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </nav>
    )}
    <div class="lk-footer__base">
      <p>{legal}</p>
      <LocaleSwitch site={site} locale={locale} path={path} label={labels.language} />
    </div>
  </div>
</footer>

<style>
  @layer sections {
    .lk-footer {
      padding-block: var(--space-xl) var(--space-m);
      border-block-start: var(--border-width) solid var(--tone-line);
      font-size: var(--step--1);
    }
    .lk-footer__inner {
      display: grid;
      gap: var(--space-l);
    }
    .lk-footer__brand {
      display: grid;
      gap: var(--space-s);
      align-content: start;
      /* logos are often dir="ltr"; don't let them stretch and align to the wrong edge in RTL */
      justify-items: start;
    }
    .lk-footer__tagline {
      max-inline-size: 36ch;
      color: var(--tone-fg-muted);
    }
    .lk-footer__wordmark {
      display: none;
      overflow-wrap: anywhere;
      font-family: var(--font-display);
      font-size: clamp(3rem, 13vw, 11rem);
      font-weight: var(--weight-display);
      line-height: 0.95;
      letter-spacing: var(--tracking-display);
      color: var(--tone-heading);
    }
    .lk-footer__contact {
      display: grid;
      gap: var(--space-3xs);
      color: var(--tone-fg-muted);
    }
    .lk-footer__contact li {
      display: flex;
      align-items: center;
      gap: 0.5em;
    }
    .lk-footer__contact a {
      color: var(--tone-fg);
    }
    .lk-footer__social {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-2xs);
    }
    .lk-footer__social a {
      display: grid;
      place-items: center;
      inline-size: 2.75rem;
      block-size: 2.75rem;
      border: var(--border-width) solid var(--tone-line);
      border-radius: 999px;
      color: var(--tone-fg);
      transition:
        background-color var(--motion-fast) var(--motion-ease),
        color var(--motion-fast) var(--motion-ease);
    }
    .lk-footer__social a:hover {
      background: var(--tone-accent);
      border-color: var(--tone-accent);
      color: var(--tone-on-accent);
    }
    .lk-footer__nav {
      display: grid;
      gap: var(--space-m);
      grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr));
    }
    .lk-footer__heading {
      font-family: var(--font-label);
      margin-block-end: var(--space-xs);
    }
    .lk-footer__group ul {
      display: grid;
      gap: var(--space-3xs);
    }
    .lk-footer__group a {
      display: inline-flex;
      align-items: center;
      min-block-size: 2rem;
      color: var(--tone-fg);
      text-decoration: none;
    }
    .lk-footer__group a:hover {
      text-decoration: underline;
    }
    .lk-footer__base {
      display: flex;
      flex-wrap: wrap;
      justify-content: space-between;
      align-items: center;
      gap: var(--space-s);
      padding-block-start: var(--space-s);
      border-block-start: var(--border-width) solid var(--tone-line);
      color: var(--tone-fg-muted);
    }
    @media (min-width: 64rem) {
      .lk-footer__inner {
        grid-template-columns: 5fr 7fr;
      }
      .lk-footer__base,
      .lk-footer__wordmark {
        grid-column: 1 / -1;
      }
    }

    /* ---------------------------------------------------------------- layouts */
    .lk-footer[data-layout="brand"] .lk-footer__wordmark {
      display: block;
    }
    /* simple and centered: group headings stay for screen readers, links sit in rows */
    .lk-footer:is([data-layout="simple"], [data-layout="centered"]) .lk-footer__heading {
      position: absolute;
      inline-size: 1px;
      block-size: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
    .lk-footer:is([data-layout="simple"], [data-layout="centered"]) .lk-footer__nav,
    .lk-footer:is([data-layout="simple"], [data-layout="centered"]) .lk-footer__group ul {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-2xs) var(--space-m);
    }
    .lk-footer[data-layout="simple"] .lk-footer__tagline {
      display: none;
    }
    .lk-footer[data-layout="centered"] .lk-footer__inner,
    .lk-footer[data-layout="centered"] .lk-footer__brand {
      justify-items: center;
      text-align: center;
    }
    .lk-footer[data-layout="centered"] .lk-footer__nav,
    .lk-footer[data-layout="centered"] .lk-footer__group ul,
    .lk-footer[data-layout="centered"] .lk-footer__base,
    .lk-footer[data-layout="centered"] .lk-footer__social {
      justify-content: center;
    }
    .lk-footer[data-layout="minimal"] :is(.lk-footer__nav, .lk-footer__tagline, .lk-footer__contact) {
      display: none;
    }
    .lk-footer[data-layout="minimal"] .lk-footer__brand {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
    }
    @media (min-width: 64rem) {
      .lk-footer:is([data-layout="simple"], [data-layout="minimal"], [data-layout="centered"]) .lk-footer__inner {
        grid-template-columns: 1fr;
      }
      .lk-footer[data-layout="simple"] .lk-footer__inner {
        grid-template-columns: auto 1fr;
        align-items: center;
      }
      .lk-footer[data-layout="simple"] .lk-footer__nav {
        justify-content: end;
      }
    }
  }
</style>
