---
/**
 * A photographic proof section: on wide screens one tall frame beside smaller ones; on phones a
 * keyboard-accessible swipe row running to the edge. Captions sit on the image's darkened foot.
 */
import type { ImageMetadata } from "astro";
import Section from "../primitives/Section.astro";
import SectionHeader from "../primitives/SectionHeader.astro";
import Media from "../primitives/Media.astro";
import Scroller from "../primitives/Scroller.astro";

export interface MosaicItem {
  src: ImageMetadata;
  alt: string;
  caption?: string;
  label?: string;
  focus?: string;
}

export interface Props {
  id: string;
  tone?: string;
  eyebrow?: string;
  index?: string;
  title: string;
  lead?: string;
  items: MosaicItem[];
  headerLayout?: "stack" | "split" | "center";
  class?: string;
}

const { id, tone, eyebrow, index, title, lead, items, headerLayout = "split", class: cls } = Astro.props;
const headingId = `${id}-title`;
const [lead1, ...side] = items;
---

<Section id={id} tone={tone} labelledby={headingId} class:list={["lk-mosaic", cls]}>
  <SectionHeader id={headingId} title={title} eyebrow={eyebrow} index={index} lead={lead} layout={headerLayout} />

  {lead1 && (
    <div class="lk-mosaic__grid lk-reveal" style={`--side:${Math.max(side.length, 1)}`}>
      {[lead1, ...side].map((m, i) => (
        <figure class:list={["lk-mosaic__tile", i === 0 && "lk-mosaic__tile--lead"]}>
          <Media src={m.src} alt={m.alt} focus={m.focus} fill sizes={i === 0 ? "(min-width: 80rem) 46rem, 58vw" : "(min-width: 80rem) 32rem, 42vw"} />
          {(m.caption || m.label) && (
            <figcaption>
              {m.label && <span class="lk-mosaic__label">{m.label}</span>}
              {m.caption && <span class="lk-mosaic__caption">{m.caption}</span>}
            </figcaption>
          )}
        </figure>
      ))}
    </div>
  )}

  <Scroller label={title} class="lk-mosaic__row">
    {items.map((m) => (
      <li>
        <figure class="lk-mosaic__tile lk-mosaic__tile--row">
          <Media src={m.src} alt={m.alt} focus={m.focus} fill sizes="(min-width: 40rem) 26rem, 80vw" />
          {(m.caption || m.label) && (
            <figcaption>
              {m.label && <span class="lk-mosaic__label">{m.label}</span>}
              {m.caption && <span class="lk-mosaic__caption">{m.caption}</span>}
            </figcaption>
          )}
        </figure>
      </li>
    ))}
  </Scroller>
</Section>

<style>
  @layer sections {
    .lk-mosaic__grid {
      display: none;
    }
    .lk-mosaic__tile {
      position: relative;
      isolation: isolate;
      overflow: hidden;
      border-radius: var(--radius-media);
      background: var(--tone-surface);
    }
    .lk-mosaic__tile--row {
      aspect-ratio: 4 / 5;
    }
    .lk-mosaic__tile::after {
      content: "";
      position: absolute;
      inset: 0;
      z-index: 0;
      background: linear-gradient(to top, rgb(0 0 0 / 0.82) 0%, rgb(0 0 0 / 0.35) 40%, transparent 65%);
    }
    figcaption {
      position: absolute;
      inset-inline: 0;
      inset-block-end: 0;
      z-index: 1;
      display: grid;
      gap: 0.25em;
      padding: var(--space-m);
      color: #fff;
    }
    .lk-mosaic__label {
      font-size: var(--step--1);
      opacity: 0.9;
    }
    .lk-mosaic__caption {
      font-size: var(--step-1);
      font-weight: var(--weight-heading);
      line-height: 1.3;
    }
    @media (min-width: 64rem) {
      .lk-mosaic__grid {
        display: grid;
        grid-template-columns: 7fr 5fr;
        grid-template-rows: repeat(var(--side), 1fr);
        gap: var(--space-xs);
        block-size: min(86vh, 48rem);
      }
      .lk-mosaic__tile--lead {
        grid-row: 1 / -1;
      }
      .lk-mosaic :global(.lk-mosaic__row) {
        display: none;
      }
    }
  }
</style>
