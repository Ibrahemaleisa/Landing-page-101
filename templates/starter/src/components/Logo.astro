---
/** Replace with your logo (inline SVG keeps it crisp and themable through currentColor). */
---

<span class="logo" dir="ltr">
  __TITLE__
</span>

<style>
  @layer site {
    .logo {
      font-family: var(--font-display);
      font-weight: 700;
      font-size: 1.25rem;
      letter-spacing: -0.02em;
    }
  }
</style>
